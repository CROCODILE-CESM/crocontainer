./xmlchange NTASKS=1

# See also SourceMods/src.mom/diag_table in this same directory. CIME's
# apply_user_mods copies any testmods file under a "src*" directory via a
# literal include_dir->caseroot string replace (CIME/user_mod_support.py)
# -- it does NOT insert "SourceMods/" itself, so the path inside this
# testmods dir has to already be SourceMods/src.mom/... or the copy fails
# with "Could not write file .../src.mom/diag_table in caseroot" (no such
# directory exists at the case root). Once actually in
# caseroot/SourceMods/src.mom/, MOM6's buildnml copies it to rundir/diag_table
# verbatim and skips diag_table.yaml-template generation entirely
# (config_component.xml documents this as the supported way to customize
# OCN_DIAG_MODE output). The generated diag_table's "static" file entry
# omits the new_file_freq/new_file_freq_units pair the other entries have,
# which this container's FMS build parses as a FATAL ("Invalid new file
# frequency units") rather than the older lenient behavior -- since this
# is just a smoke test with no need to inspect diagnostic output,
# side-step the whole template instead of patching the external
# diag_table.yaml.
#
# The base regional testmods hardcode OCN_NX/NY=60 (and ICE_/WAV_ to
# match) for the original 3deg/0.05res Panama fixture. mom-regional-base.yaml
# was shrunk to 1deg/0.1res (10x10 cells) to keep this a fast smoke test --
# these must match that grid or MOM6 crashes reading a 10x10 supergrid file
# against a case configured for 60x60. Applied after mom/regional/base via
# CIME's "--" multi-mods composition, so these overrides win.
./xmlchange OCN_NX=10
./xmlchange OCN_NY=10
./xmlchange ICE_NX=10
./xmlchange ICE_NY=10
./xmlchange WAV_NX=10
./xmlchange WAV_NY=10

# base's shell_commands points ROF2OCN_LIQ/ICE_RMAPNAME at a GLOFAS
# runoff-mapping file unconditionally, regardless of which ROF component is
# actually active. Our compset_override (see regional_configs/*.yaml) swaps
# in SROF, which never uses a runoff map, so there's nothing to point these
# at -- "unset" is CIME's own sentinel for "no mapping needed" (any XML
# value with no "/" in it is treated as a special value and skipped by
# check_input_data -- see CIME/case/check_input_data.py), not a workaround.
./xmlchange ROF2OCN_LIQ_RMAPNAME=unset
./xmlchange ROF2OCN_ICE_RMAPNAME=unset

# mom/regional/base's user_nl_mom (external MOM_interface repo) matches the
# original full Panama fixture: 60x60/nk=75 domain, tides on (TPXO-derived
# tu_segment/tz_segment files), chlorophyll from file (a SeaWiFS-derived
# file). CrocoDash's REFERENCE_OCEAN only synthesizes OBC/IC ocean data, not
# tides or chlorophyll (no synthetic TPXO/SeaWiFS generator exists), so
# mom-regional-base.yaml's regen never produces those files.
#
# CIME concatenates every testmods-supplied user_nl_mom fragment into this
# case's user_nl_mom during case.setup, and buildnml (at case.build) errors
# "listed more than once" on ANY duplicate key -- there's no "last one
# wins" override semantics. So the smaller domain / no-tides / no-chl
# values can't be layered on as another user_nl_mom testmods fragment; they
# have to patch the case's own concatenated user_nl_mom file directly.
# shell_commands is the one point in create_test's lifecycle that runs
# after case.setup (when user_nl_mom already has base's content) and before
# case.build (when it gets parsed) -- exactly where the NTASKS/OCN_NX
# overrides above already apply cleanly.
python3 - <<'PYEOF'
import re

path = "user_nl_mom"
with open(path) as f:
    text = f.read()

# Values from mom-regional-base.yaml/mom-regional-bgc.yaml's shrunk domain
# (0.1deg, 10x10 cells, nk=10) -- must match the actual generated
# grid/vgrid netCDF dimensions or MOM6 crashes with a dimension mismatch
# reading them. TIDES/CHL_FROM_FILE are turned off since no tidal/
# chlorophyll input files are generated. READ_RIV_FLUXES is bgc-only
# (absent from base's user_nl_mom, so a harmless no-op there) -- see
# bgc_detail_keys below for why it can't just be left at its testmods
# default.
overrides = {
    "NIGLOBAL": "10",
    "NJGLOBAL": "10",
    "NK": "10",
    "TIDES": "False",
    "CHL_FROM_FILE": "FALSE",
    "READ_RIV_FLUXES": "False",
}

# TIDES=False alone doesn't stop MOM6's OBC registry from still expecting
# Uamp/Vamp/SSHamp tidal fields in OBC_SEGMENT_*_DATA -- it's driven by
# these separate tidal-detail params (still True/set from base's
# user_nl_mom regardless of TIDES), which crashed with "FATAL: Values
# needed for OBC segment 1" once those fields were stripped below. Drop
# them outright; with tides fully off none of them are meaningful.
tide_detail_keys = (
    "TIDE_M2",
    "CD_TIDES",
    "TIDE_USE_EQ_PHASE",
    "TIDE_REF_DATE",
    "OBC_TIDE_ADD_EQ_PHASE",
    "OBC_TIDE_N_CONSTITUENTS",
    "OBC_TIDE_CONSTITUENTS",
    "OBC_TIDE_REF_DATE",
)

# CHL_FROM_FILE=FALSE alone doesn't stop MOM6 from needing a chlorophyll
# source -- VAR_PEN_SW=True (still set from base) tells it to vary
# shortwave penetration by chlorophyll, and with no file and no
# MOM_generic_tracer/MARBL active it fell through to "get_chl_from_model"
# and crashed FATAL. Drop VAR_PEN_SW/PEN_SW_NBANDS/CHL_FILE outright so
# MOM6 uses its own default (non-chlorophyll-dependent) shortwave scheme.
chl_detail_keys = (
    "CHL_FILE",
    "VAR_PEN_SW",
    "PEN_SW_NBANDS",
)

# mom/regional/bgc's user_nl_mom (external MOM_interface repo) sets a real
# MARBL tracer IC file, three grid-native iron-flux files, and a river-
# nutrient flux file/toggle -- none of which CrocoDash's REFERENCE_OCEAN
# forcing (no marbl_var_names) produces. Drop them outright so MOM6/MARBL
# falls back to its own internal tracer initialization instead of trying
# to read data this regen never generates. Absent from base's user_nl_mom,
# so a no-op there.
bgc_detail_keys = (
    "MARBL_TRACERS_IC_FILE",
    "MARBL_FESEDFLUX_FILE",
    "MARBL_FEVENTFLUX_FILE",
    "MARBL_FESEDFLUXRED_FILE",
    "RIV_FLUX_FILE",
)

for key in (*overrides, *tide_detail_keys, *chl_detail_keys, *bgc_detail_keys):
    text = re.sub(rf"(?m)^{re.escape(key)}\s*=.*\n?", "", text)

# bgc's testmods also set one OBC_DATA_<tracer> line per MARBL tracer
# (PO4, NO3, DIC, ...) -- same "no marbl_var_names" reason as above. Strip
# by pattern rather than a hardcoded tracer list so this doesn't silently
# stop working if MOM_interface's tracer list changes.
text = re.sub(r"(?m)^OBC_DATA_\w+\s*=.*\n?", "", text)

# base's OBC_SEGMENT_*_DATA lines include Uamp/Uphase/Vamp/Vphase/SSHamp/
# SSHphase referencing tidal files (tu_segment_*.nc/tz_segment_*.nc) that
# don't exist without tides -- replace with the plain (non-tidal) form,
# same as what CrocoDash's own regen would write for a no-tides case.
obc_segments = {}
for seg in ("001", "002", "003", "004"):
    key = f"OBC_SEGMENT_{seg}_DATA"
    text = re.sub(rf"(?m)^{re.escape(key)}\s*=.*\n?", "", text)
    obc_segments[key] = (
        f'"U=file:forcing_obc_segment_{seg}.nc(u),'
        f'V=file:forcing_obc_segment_{seg}.nc(v),'
        f'SSH=file:forcing_obc_segment_{seg}.nc(eta),'
        f'TEMP=file:forcing_obc_segment_{seg}.nc(temp),'
        f'SALT=file:forcing_obc_segment_{seg}.nc(salt)"'
    )

text += "\n! container_smoke overrides: smaller domain, no tides/chlorophyll\n"
for key, value in overrides.items():
    text += f"{key} = {value}\n"
for key, value in obc_segments.items():
    text += f"{key} = {value}\n"

with open(path, "w") as f:
    f.write(text)
PYEOF
